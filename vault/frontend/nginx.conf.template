# Rate limiting zone — 10 requests/sec per client IP
limit_req_zone $binary_remote_addr zone=vault_limit:10m rate=10r/s;

server {
    listen 3000;
    server_name localhost;

    # Hide Nginx version from Server header
    server_tokens off;

    # Default body size limit — override per-location as needed
    client_max_body_size 1m;

    # ── Global security headers ──
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss: http: https:; frame-ancestors 'none'" always;

    # ── Static frontend SPA ──
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
            expires 7d;
            add_header Cache-Control "public, immutable";
        }
    }

    # ── API proxy locations ──

    location /nodes {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/nodes;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }

    location /health {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }

    location /events {
        proxy_pass http://${COORDINATOR_HOSTPORT}/events;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_hide_header X-Powered-By;
    }

    location /objects {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/objects;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
        client_max_body_size 50M;
    }

    location /replication {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/replication;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }

    location /faults {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/faults;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }

    location /repair {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/repair;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }

    location /integrity {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/integrity;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }

    location /rebalance {
        limit_req zone=vault_limit burst=20 nodelay;
        proxy_pass http://${COORDINATOR_HOSTPORT}/rebalance;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header X-Powered-By;
    }
}

